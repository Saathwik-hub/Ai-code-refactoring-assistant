# ==============================================================================
# AI Code Refactoring Assistant - Environment Configuration Template
# ==============================================================================
# Duplicate this file as .env and update the values for your environment.
# NEVER commit the actual .env file with real credentials or secret keys.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Local AI / Ollama Service Configuration
# Default local Ollama host; change if running Ollama in Docker or remote server
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_OLLAMA_MODEL=qwen2.5-coder

# CORS Configuration (comma-separated list of allowed origins, or * for all)
CORS_ORIGINS=*

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=5

# Security (Placeholder for production token signing)
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
